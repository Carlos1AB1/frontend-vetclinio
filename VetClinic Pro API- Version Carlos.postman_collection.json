	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "1. Login (Admin)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.success && jsonData.data) {",
									"        pm.collectionVariables.set('accessToken', jsonData.data.token);",
									"        pm.collectionVariables.set('refreshToken', jsonData.data.refreshToken);",
									"        pm.collectionVariables.set('userId', jsonData.data.id);",
									"        console.log('✅ Token guardado: ' + jsonData.data.token);",
									"        console.log('✅ User ID: ' + jsonData.data.id);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						},
						"description": "Login con usuario administrador por defecto"
					},
					"response": []
				},
